# Copy to .env and fill in. Never commit .env.

# xAI (required for classify / digest writing)
XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_BASE_URL=https://api.x.ai/v1

# Optional. If unset, `gh auth token` is used when available.
GITHUB_TOKEN=

# Heavy data lives on the backup disk, not the OS disk.
HAI_DATA_DIR=/mnt/backup/hanews/data
HAI_CACHE_DIR=/mnt/backup/hanews/cache

# Digests stay in the git repo so they can be pushed to GitHub.
# Leave empty to use <repo>/output
HAI_OUTPUT_DIR=

# Digest calendar date uses this timezone.
HAI_TIMEZONE=America/Puerto_Rico

# Cap LLM calls per run so a first ingest cannot run away.
HAI_MAX_CLASSIFY_PER_RUN=40
